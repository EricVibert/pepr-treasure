---
// Page Équipe / Comité de pilotage (COPIL) du PEPR TREASURE.
// Résumés établis à partir de sources publiques ; à compléter/valider.
import Base from '../layouts/Base.astro';

const membres = [
  {
    nom: 'Agnès Audier',
    photo: '/copil/audier.jpg',
    initiales: 'AA',
    role: 'Co-porteuse du PEPR TREASURE',
    affiliation: 'Senior Advisor, Boston Consulting Group (BCG) · experte, Institut Montaigne',
    resume: 'Ancienne élève de l’École normale supérieure et de Sciences Po, ingénieure en chef des Mines. Parcours entre secteurs public et privé : cabinets ministériels (Santé, PME & Commerce), directions stratégie et opérations chez Vivendi puis Havas, avant de rejoindre le BCG en 2007. Administratrice de grands groupes cotés, spécialiste des enjeux numériques et sociétaux, en particulier dans la santé.',
  },
  {
    nom: 'Pr Guillaume Coutance',
    photo: '/copil/coutance.jpg',
    initiales: 'GC',
    role: 'Membre du comité de pilotage',
    affiliation: 'Chirurgie cardiaque & transplantation, AP-HP (Pitié-Salpêtrière / HEGP)',
    resume: 'Spécialiste de l’insuffisance cardiaque avancée et de la transplantation cardiaque à la Pitié-Salpêtrière, qui abrite le plus grand programme européen de greffe cardiaque. Il mène des projets de recherche sur la greffe du cœur avec le Paris Transplant Group (INSERM PARCC), notamment sur l’allocation des greffons et le rejet aigu et chronique.',
  },
  {
    nom: 'Pr Nassim Kamar',
    photo: '/copil/kamar.jpg',
    initiales: 'NK',
    role: 'Membre du comité de pilotage',
    affiliation: 'Néphrologie & transplantation d’organes, CHU de Toulouse (Hôpital Rangueil)',
    resume: 'Néphrologue, chef du service de néphrologie et transplantation d’organes et coordinateur de la transplantation au CHU de Toulouse — premier centre français pour la greffe rénale ces dernières années. Clinicien et chercheur, il est fortement impliqué dans la recherche sur la transplantation rénale et l’immunosuppression.',
  },
  {
    nom: 'Dr Hannah Kaminski',
    photo: '/copil/kaminski.jpg',
    initiales: 'HK',
    linkedin: 'https://www.linkedin.com/in/hannah-kaminski-30b298210/',
    role: 'Membre du comité de pilotage',
    affiliation: 'Néphrologie–transplantation rénale, CHU de Bordeaux (Pellegrin) · Université de Bordeaux, CNRS UMR 5164 ImmunoConcEpT',
    resume: 'Praticienne hospitalière en néphrologie et transplantation rénale au CHU de Bordeaux et enseignante-chercheuse (Université de Bordeaux, laboratoire ImmunoConcEpT). Elle coordonne le consortium européen HORUS (Horizon Europe, 7 M€, 2021-2027), qui étudie les interactions entre l’hôte et le cytomégalovirus (CMV) en transplantation d’organes solides.',
  },
  {
    nom: 'Dr Fanny Lebossé',
    photo: '/copil/lebosse.jpg',
    initiales: 'FL',
    role: 'Membre du comité de pilotage',
    affiliation: 'Hépatologie & transplantation hépatique, Hospices Civils de Lyon (Hôpital de la Croix-Rousse)',
    resume: 'Hépatologue (MCU-PH) aux Hospices Civils de Lyon, spécialiste des maladies du foie et de la transplantation hépatique. Chercheuse au Centre de recherche en cancérologie de Lyon (CRCL), elle travaille notamment sur l’insuffisance hépatique aiguë sur chronique (ACLF) et les indications de greffe.',
  },
  {
    nom: 'Pr Alexandre Loupy',
    photo: '/copil/loupy.jpg',
    initiales: 'AL',
    role: 'Co-porteur du PEPR TREASURE',
    affiliation: 'Néphrologie & épidémiologie, Université Paris Cité / INSERM (PARCC) · directeur du Paris Transplant Group (PITOR)',
    resume: 'Néphrologue, professeur à l’Université Paris Cité et directeur du Paris Transplant Group (Institut PITOR, PARCC – Inserm). Il a conçu et validé l’iBox, biomarqueur numérique fondé sur l’IA qui prédit la survie du greffon et l’efficacité de l’immunosuppression, aujourd’hui déployé sur plus de 35 000 patients et une quarantaine de centres sur quatre continents. Lauréat d’une ERC Consolidator Grant.',
  },
  {
    nom: 'Pr Éric Vibert',
    photo: '/copil/vibert.jpg',
    initiales: 'EV',
    role: 'Co-porteur du PEPR TREASURE',
    affiliation: 'Centre Hépato-Biliaire, Hôpital Paul-Brousse (AP-HP) · Université Paris-Saclay',
    resume: 'Chirurgien, directeur chirurgical de la transplantation hépatique au Centre Hépato-Biliaire de l’hôpital Paul-Brousse (AP-HP) et professeur à l’Université Paris-Saclay. Fondateur des programmes d’innovation au bloc opératoire BOPA, BOPEx et BOPTech, il est co-porteur du PEPR TREASURE.',
  },
  {
    nom: 'Pr François Pattou',
    photo: '/copil/pattou.jpg',
    initiales: 'FP',
    role: 'Co-porteur du PEPR TREASURE',
    affiliation: 'Chirurgie générale & endocrinienne, CHU de Lille · Université de Lille / INSERM U1190 (EGID)',
    resume: 'Chirurgien, professeur de chirurgie générale à l’Université de Lille et chef du service de chirurgie générale et endocrinienne du CHU de Lille. Pionnier mondial de la greffe d’îlots pancréatiques dans le diabète de type 1 (INSERM U1190 – EGID, Institut Pasteur de Lille) : le CHU de Lille a été le premier établissement français à greffer des îlots de Langerhans en routine (2021).',
  },
];
---

<Base
  title="Équipe / Comité de pilotage — PEPR TREASURE"
  description="Le comité de pilotage (COPIL) du PEPR TREASURE : les personnes qui portent et orientent le programme."
>
  <section class="hero">
    <p class="eyebrow">PEPR TREASURE</p>
    <h1>Comité de pilotage</h1>
    <p class="lede">
      Le COPIL réunit les personnes qui portent et orientent le programme
      TREASURE.
    </p>
  </section>

  <section class="block">
    <ul class="members">
      {membres.map((m) => (
        <li>
          {m.photo
            ? <img class="avatar" src={m.photo} alt={`Portrait de ${m.nom}`} width="440" height="440" loading="lazy" />
            : <div class="avatar avatar--initiales" aria-hidden="true">{m.initiales}</div>}
          <div class="m-body">
            <h2>{m.nom}</h2>
            <p class="role">{m.role}</p>
            <p class="affil">{m.affiliation}</p>
            <p class="resume">{m.resume}</p>
            <p class="links">
              <a
                class="link-btn"
                href={`https://scholar.google.com/scholar?q=${encodeURIComponent(m.nom.replace(/^(Pr|Dr)\s+/, ''))}`}
                target="_blank"
                rel="noopener"
              >Publications (Google Scholar)</a>
              {m.linkedin && (
                <a class="link-btn" href={m.linkedin} target="_blank" rel="noopener">LinkedIn</a>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <p class="note">Résumés établis à partir de sources publiques — à compléter et valider avec les intéressés.</p>
  </section>
</Base>

<style>
  .hero { padding: var(--space-4) 0 var(--space-2); max-width: 46rem; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-dark);
    margin-bottom: var(--space-3);
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-accent); margin-bottom: var(--space-3); }
  .lede { font-size: var(--text-lg); color: var(--color-muted); }

  .block { margin-top: var(--space-4); }
  .members {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .members li {
    display: flex;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }
  .avatar {
    flex: 0 0 auto;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-accent-soft);
    border: 2px solid var(--color-accent-soft);
  }
  .avatar--initiales {
    background: var(--color-accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: var(--text-lg);
  }
  .m-body h2 { font-size: var(--text-lg); color: var(--color-accent-dark); margin-bottom: 0.15rem; }
  .role { font-weight: 700; color: var(--color-accent); font-size: var(--text-sm); margin-bottom: 0.15rem; }
  .affil { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--space-2); }
  .resume { color: var(--color-ink); font-size: var(--text-base); }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .link-btn {
    display: inline-flex;
    align-items: center;
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .link-btn:hover { background: var(--color-accent); color: #fff; }

  .note { margin-top: var(--space-4); color: var(--color-muted); font-size: var(--text-sm); font-style: italic; }

  @media (max-width: 700px) { .members { grid-template-columns: 1fr; } }
</style>
