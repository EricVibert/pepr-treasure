---
// Page d'accueil — version d'amorçage. Le titre est en place ; le reste du
// site sera construit lors d'une prochaine session de setup.
import Base from '../layouts/Base.astro';
---

<Base
  title="PEPR TREASURE"
  description="PEPR TREASURE — Programme et Équipements Prioritaires de Recherche, France 2030."
>
  <section class="hero">
    <p class="eyebrow">France&nbsp;2030 · Programme et Équipements Prioritaires de Recherche</p>
    <h1>PEPR&nbsp;TREASURE</h1>
    <p class="lede">
      Un programme de recherche au service de la connaissance et de l'innovation.
      Le site complet arrive prochainement.
    </p>
    <p class="soon"><span class="dot" aria-hidden="true"></span> Site en construction</p>
  </section>
</Base>

<style>
  .hero {
    max-width: 46rem;
    padding: var(--space-4) 0;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .hero h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    letter-spacing: -0.02em;
    color: #d12b2b; /* test : titre en rouge */
    margin-bottom: var(--space-3);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 34rem;
  }
  .soon {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
</style>
