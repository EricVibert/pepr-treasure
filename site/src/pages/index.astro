---
// Page d'accueil PEPR TREASURE — présentation synthétique du programme.
// Contenu tiré du résumé fourni par le propriétaire (2026-07-23).
import Base from '../layouts/Base.astro';
import SchemaProjet from '../components/SchemaProjet.astro';

const organes = [
  'Rein', 'Foie', 'Cœur', 'Poumon', 'Trachée', 'Îlots', 'Tissus composites',
];

const axes = [
  'Chaînage et valorisation des données de transplantation',
  'Intelligence artificielle & modèles prédictifs',
  'Machines de perfusion & hubs régionaux',
  'Nouveaux biomarqueurs et plateformes diagnostiques',
  'Outils avancés d’immuno-monitoring',
  'Processus de travail harmonisés pour la recherche collaborative',
];

const objectifs = [
  {
    stat: '+15 %',
    text: 'de greffes réussies, en optimisant l’attribution et la préservation des organes grâce aux modèles prédictifs d’IA et aux machines de perfusion ex-situ.',
  },
  {
    stat: '+20 / +40 %',
    text: 'de greffes de trachées (+20 %) et d’îlots de pancréas (+40 %).',
  },
  {
    stat: '‑50 %',
    text: 'de gestes invasifs (biopsies de l’organe transplanté) sans impact thérapeutique.',
  },
  {
    stat: '30 %',
    text: 'des diagnostics de « rejet » reclassés par une immunologie de précision (microscopie moléculaire et digitale).',
  },
  {
    stat: '20 centres',
    text: 'de greffe au moins équipés d’outils numériques de diagnostic de précision avant et après greffe — la « AI transplant clinic ».',
  },
];
---

<Base
  title="PEPR TREASURE — Transplantation d’organes"
  description="TREASURE (Transplantation, REgeneration And preservation of OrganS) — le PEPR dédié à la transplantation d’organes, financé par France 2030 et piloté par l’INSERM."
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="eyebrow">France&nbsp;2030 · INSERM — Agence de programmes de recherche en Santé</p>
        <h1>PEPR TREASURE</h1>
        <p class="expand">Transplantation, REgeneration And preservation of OrganS</p>
        <p class="lede">
          Le Programme d’Équipement Prioritaire de Recherche dédié à la
          transplantation d’organes. Notre ambition : améliorer significativement
          les résultats de la greffe grâce à une approche unique qui fédère toute
          la communauté française de la transplantation — tous organes confondus.
        </p>
        <ul class="chips" aria-label="Organes couverts">
          {organes.map((o) => <li>{o}</li>)}
        </ul>
      </div>
      <div class="hero-medallion">
        <img src="/logo-treasure.png" alt="Logo du PEPR TREASURE" width="573" height="460" />
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Le projet en un coup d’œil</h2>
    <p class="block-lede">
      Sept work packages complémentaires, des infrastructures de données
      jusqu’à l’éthique et la formation.
    </p>
    <SchemaProjet />
  </section>

  <section class="block">
    <h2>Une approche unifiée et multidisciplinaire</h2>
    <p>
      TREASURE réunit chercheurs, cliniciens, ingénieurs, spécialités médicales
      et chirurgicales, anesthésistes-réanimateurs, biologistes, immunologistes,
      anatomopathologistes — mais aussi les sociétés savantes, les hôpitaux, les
      établissements publics, les associations de patients et les industriels du
      médicament et de la MedTech. L’objectif : faire émerger de nouvelles
      infrastructures et technologies de pointe pour transformer la manière dont
      les greffes sont réalisées, surveillées et évaluées.
    </p>
  </section>

  <section class="block">
    <h2>Objectifs 2025-2030</h2>
    <p class="block-lede">
      Cinq objectifs cliniques à cinq ans, portés par les infrastructures de
      recherche du programme.
    </p>
    <ul class="objectifs">
      {objectifs.map((o) => (
        <li>
          <span class="stat">{o.stat}</span>
          <span class="stat-text">{o.text}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <h2>Nos axes d’innovation</h2>
    <ul class="axes">
      {axes.map((a) => <li>{a}</li>)}
    </ul>
  </section>

  <p class="soon"><span class="dot" aria-hidden="true"></span> Site en construction — le programme détaillé arrive prochainement.</p>
</Base>

<style>
  /* Grand visuel d'accueil : bande verte pleine largeur, flush sous l'en-tête. */
  .hero {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: calc(-1 * var(--space-5));
    margin-bottom: var(--space-5);
    padding: var(--space-5) var(--space-4);
    background:
      radial-gradient(120% 140% at 85% 10%, rgba(255,255,255,0.14), rgba(255,255,255,0) 55%),
      linear-gradient(135deg, #0f5a37 0%, #17864f 55%, #0f5a37 100%);
    color: #fff;
  }
  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-5);
  }
  .hero-text { max-width: 40rem; }

  .hero .eyebrow { color: #bfe6cf; }
  .hero h1 { color: #ffffff; }
  .hero .expand { color: #eaf6ee; }
  .hero .lede { color: rgba(255, 255, 255, 0.92); }
  .hero .chips li {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .hero-medallion {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.22);
    flex: 0 0 auto;
  }
  .hero-medallion img {
    width: 74%;
    height: auto;
  }

  @media (max-width: 820px) {
    .hero { padding: var(--space-4) var(--space-3); }
    .hero-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-4);
    }
    .hero-medallion { order: -1; width: 200px; height: 200px; }
    .hero .chips { justify-content: center; }
    .hero-text { max-width: 100%; }
    .hero h1 { font-size: clamp(2rem, 9vw, 3.2rem); }
    .hero .expand { font-size: var(--text-base); }
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-2); /* rouge « cœur » AP-HP */
    margin-bottom: var(--space-4);
  }
  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 5rem);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
    /* couleur définie plus haut (#fff) : titre blanc sur la bande verte */
  }
  .expand {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 40rem;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .chips li {
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .block {
    max-width: 46rem;
    margin-top: var(--space-5);
  }
  .block h2 {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .block p {
    color: var(--color-ink);
  }
  .block-lede {
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }
  .schema-fig { margin: 0; }
  .schema-fig a {
    display: block;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: var(--space-3);
  }
  .schema-fig img { width: 100%; height: auto; display: block; }
  .schema-fig figcaption {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .objectifs {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .objectifs li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }
  .objectifs .stat {
    flex: 0 0 auto;
    min-width: 6.5rem;
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-accent-2); /* chiffre en rouge « cœur » */
  }
  .objectifs .stat-text {
    color: var(--color-ink);
  }
  @media (max-width: 560px) {
    .objectifs li { flex-direction: column; gap: var(--space-1); }
    .objectifs .stat { font-size: var(--text-lg); }
  }

  .axes {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .axes li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--color-ink);
  }
  .axes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent-2); /* puce rouge « cœur » */
  }

  .soon {
    margin-top: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
</style>
