---
// Work Package 6 — AI transplant clinic (English).
import Base from '../../layouts/Base.astro';

const tags = ['Graft allocation', 'Rejection score', 'iBox', 'Digital twins'];

const axes = [
  {
    num: '1',
    titre: 'Optimising graft allocation',
    texte: 'Scalable AI algorithms propose the best donor/recipient match. Beyond classic compatibility criteria, they analyse immunological, genomic and medical profiles to maximise long-term success, reduce waiting-list mortality and assess the potential utility of a transplant.',
  },
  {
    num: '2',
    titre: 'Precision diagnostics and fewer invasive procedures',
    texte: 'By combining clinical, biological and histological data, AI computes an individualised rejection-risk score to identify patients for whom a biopsy would be unnecessary. A “digital biopsy” generates quantitative lesion scores (qLesion) for automated, standardised analysis, more reliable than conventional histology.',
  },
  {
    num: '3',
    titre: 'Prognosis of post-transplant risks',
    texte: 'Powerful predictive models anticipate major long-term complications (graft loss, death, cancers, infections, cardiovascular events). The globally validated iBox system will be enhanced to compute these risk scores.',
  },
  {
    num: '4',
    titre: 'Personalisation through “digital twins”',
    texte: 'All these predictions are brought together in an interactive software suite for clinicians, consolidating digital twins — a dynamic view of the patient’s health — to minimise exposure to immunosuppressants in low-risk patients and adapt therapies in real time.',
  },
];
---

<Base
  title="Work Package 6 — AI transplant clinic"
  description="PEPR TREASURE WP6: AI-based diagnostic and prognostic models for multi-organ transplant monitoring — graft allocation, rejection scores, iBox and digital twins."
>
  <section class="hero">
    <p class="eyebrow">PEPR TREASURE · Work Package 6</p>
    <h1>AI transplant clinic</h1>
    <p class="subtitle">AI-based diagnostic and prognostic models for multi-organ monitoring</p>
    <p class="lede">
      WP6 optimises patients’ <strong>immune monitoring</strong> by developing AI
      and machine-learning tools that directly leverage the ultra-precise assays
      and biomarkers produced by <strong>WP4</strong>.
    </p>
    <ul class="chips" aria-label="Keywords">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section class="block">
    <h2>Axes and innovations</h2>
    <ul class="axes-cards">
      {axes.map((a) => (
        <li>
          <span class="badge">{a.num}</span>
          <div class="v-body">
            <h3>{a.titre}</h3>
            <p>{a.texte}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { padding: var(--space-4) 0 var(--space-2); max-width: 50rem; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-dark);
    margin-bottom: var(--space-3);
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-accent); margin-bottom: var(--space-2); }
  .subtitle { font-size: var(--text-lg); font-weight: 600; color: var(--color-ink); margin-bottom: var(--space-3); }
  .lede { font-size: var(--text-lg); color: var(--color-muted); }
  .lede strong { color: var(--color-ink); }

  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .chips li {
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .block { margin-top: var(--space-5); }
  .block h2 { color: var(--color-accent); margin-bottom: var(--space-4); }

  .axes-cards { list-style: none; display: grid; gap: var(--space-3); }
  .axes-cards li {
    display: flex;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }
  .axes-cards .badge {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
  }
  .v-body h3 { font-size: var(--text-lg); color: var(--color-accent-dark); margin-bottom: var(--space-2); }
  .v-body p { color: var(--color-ink); }

  @media (max-width: 520px) { .axes-cards li { flex-direction: column; } }
</style>
