---
// Work packages overview (English).
import Base from '../../layouts/Base.astro';

const wps = [
  {
    href: '/en/wp1',
    code: 'WP1',
    title: 'Augmented data',
    desc: 'A multidimensional, interoperable data space — the foundation of the AI algorithms and of the AI transplant clinic.',
  },
  {
    href: '/en/wp2',
    code: 'WP2',
    title: 'Augmented organ perfusion',
    desc: 'Preserving, testing and regenerating organs between retrieval and transplantation: the procurement platform, perfusion hubs and the “In Machina” project.',
  },
  {
    href: '/en/wp3',
    code: 'WP3',
    title: 'Augmented tissue and organ transplants',
    desc: 'Cells and innovative materials to repair grafts: pancreatic islets, bio-artificial tracheas, immunomodulation.',
  },
  {
    href: '/en/wp4-5',
    code: 'WP4 & WP5',
    title: 'Precision diagnostics & AI',
    desc: 'WP4 produces high-precision biological data; WP5 leverages it through AI for patient monitoring.',
  },
  {
    href: '/en/wp6',
    code: 'WP6',
    title: 'AI transplant clinic',
    desc: 'AI-based diagnostic and prognostic models: organ allocation, rejection scores, iBox, digital twins.',
  },
  {
    href: '/en/wp7',
    code: 'WP7',
    title: 'SSH — the donor as a research subject',
    desc: 'Social sciences and humanities: donation, and post-mortem donation in particular, within an interdisciplinary and participatory research space.',
  },
];
---

<Base
  title="Work packages — PEPR TREASURE"
  description="PEPR TREASURE work packages: augmented data (WP1), perfusion (WP2), augmented tissues (WP3), diagnostics & AI (WP4-5), AI clinic (WP6) and social sciences and humanities (WP7)."
>
  <section class="hero">
    <p class="eyebrow">PEPR TREASURE</p>
    <h1>The work packages</h1>
    <p class="lede">
      TREASURE is organised into complementary work packages, from data
      infrastructures to the social sciences and humanities. Click to explore
      each one.
    </p>
  </section>

  <section class="block">
    <ul class="wp-grid">
      {wps.map((w) => (
        <li>
          <a href={w.href}>
            <span class="code">{w.code}</span>
            <h2>{w.title}</h2>
            <p>{w.desc}</p>
            <span class="go">Learn more →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { padding: var(--space-4) 0 var(--space-2); max-width: 46rem; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-dark);
    margin-bottom: var(--space-3);
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-accent); margin-bottom: var(--space-3); }
  .lede { font-size: var(--text-lg); color: var(--color-muted); }

  .block { margin-top: var(--space-4); }
  .wp-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .wp-grid a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .wp-grid a:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(16,34,47,0.06), 0 16px 32px rgba(16,34,47,0.10);
  }
  .wp-grid .code {
    align-self: flex-start;
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
  }
  .wp-grid h2 { font-size: var(--text-lg); color: var(--color-accent-dark); margin-bottom: var(--space-2); }
  .wp-grid p { color: var(--color-muted); font-size: var(--text-base); flex: 1; }
  .wp-grid .go { margin-top: var(--space-3); font-weight: 700; color: var(--color-accent); }

  @media (max-width: 860px) { .wp-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .wp-grid { grid-template-columns: 1fr; } }
</style>
