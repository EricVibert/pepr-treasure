---
// Page Actualités du PEPR TREASURE.
// Ajouter les actualités dans le tableau ci-dessous (les plus récentes en haut).
import Base from '../layouts/Base.astro';

const actualites = [
  {
    date: '2025',
    dateLabel: '2025',
    titre: 'TREASURE, l’un des trois nouveaux programmes stratégiques de l’Agence de programmes de recherche en santé',
    texte:
      'L’État confie à l’Agence de programmes de recherche en santé, pilotée par l’Inserm, trois nouveaux programmes stratégiques — dont TREASURE, dédié à la transplantation — financés dans le cadre de France 2030 (49,5 M€ au total). TREASURE entend transformer les pratiques cliniques en combinant intelligence artificielle et biotechnologies innovantes pour optimiser la qualité des greffons, prédire le rejet et réduire les examens invasifs, avec l’ambition de déployer une « clinique de la transplantation augmentée par l’IA ».',
    lien: 'https://presse.inserm.fr/trois-nouveaux-programmes-strategiques-confies-a-lagence-de-programmes-de-recherche-en-sante-pilotee-par-linserm/71545/',
    source: 'Salle de presse de l’Inserm',
  },
];
---

<Base
  title="Actualités — PEPR TREASURE"
  description="Les actualités du PEPR TREASURE : événements, avancées, webinaires et annonces du programme."
>
  <section class="hero">
    <p class="eyebrow">PEPR TREASURE</p>
    <h1>Actualités</h1>
    <p class="lede">
      Les événements, avancées et annonces du programme.
    </p>
  </section>

  <section class="block">
    {actualites.length === 0 ? (
      <div class="empty">
        <p>Les actualités du programme seront publiées ici prochainement.</p>
      </div>
    ) : (
      <ul class="news is-list">
        {actualites.map((a) => (
          <li>
            <time datetime={a.date}>{a.dateLabel}</time>
            <h2>{a.titre}</h2>
            <p>{a.texte}</p>
            {a.lien && <a class="more" href={a.lien} target="_blank" rel="noopener">{a.source ? `Lire sur ${a.source} →` : 'En savoir plus →'}</a>}
          </li>
        ))}
      </ul>
    )}

    <aside class="linkedin-cta">
      <div>
        <h2>Suivez le PEPR TREASURE sur LinkedIn</h2>
        <p>Toutes nos annonces, événements et avancées en temps réel sur notre page LinkedIn.</p>
      </div>
      <a class="li-btn" href="https://www.linkedin.com/company/pepr-treasure/posts/?feedView=all" target="_blank" rel="noopener">
        Voir la page LinkedIn →
      </a>
    </aside>
  </section>
</Base>

<style>
  .hero { padding: var(--space-4) 0 var(--space-2); max-width: 46rem; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-dark);
    margin-bottom: var(--space-3);
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-accent); margin-bottom: var(--space-3); }
  .lede { font-size: var(--text-lg); color: var(--color-muted); }

  .block { margin-top: var(--space-4); }
  .empty {
    background: var(--color-surface);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-4);
    text-align: center;
    color: var(--color-muted);
  }

  .news { list-style: none; display: grid; gap: var(--space-3); }
  .news li {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow);
  }
  .news time { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--color-accent); letter-spacing: 0.02em; margin-bottom: var(--space-1); }
  .news h2 { font-size: var(--text-lg); color: var(--color-accent-dark); margin-bottom: var(--space-2); }
  .news p { color: var(--color-ink); }
  .news .more { display: inline-block; margin-top: var(--space-2); font-weight: 700; color: var(--color-accent); text-decoration: none; }
  .news .more:hover { text-decoration: underline; }

  .linkedin-cta {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .linkedin-cta h2 { color: var(--color-accent-dark); font-size: var(--text-lg); margin-bottom: var(--space-1); }
  .linkedin-cta p { color: var(--color-muted); }
  .li-btn {
    flex: 0 0 auto;
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
  }
  .li-btn:hover { background: var(--color-accent-dark); }
</style>
