---
// Schéma d'ensemble du projet TREASURE (WP1 → WP7), recréé en vert.
// Reprend la structure de la figure officielle du programme.
const wp1 = [
  'Dossiers de santé électroniques',
  'Registres & entrepôts de données',
  'Plateformes biologie & immunologie (EFS, CRB, labos HLA)',
  'Biocollection',
  'Collections de tissus',
  'Stockage cloud & capacités de calcul',
  'Intégration des données de tarification',
];
const wp23 = [
  'Perfusion augmentée d’organes',
  'Perfusion normothermique longue durée & évaluation innovante',
  'Greffons cliniquement augmentés (îlots pancréatiques, trachée)',
];
const wp4 = [
  'Monitoring immunitaire : ADN, ARN, métabolites, protéines, cellules, anticorps',
  'Diagnostics fondés sur le tissu du greffon',
  'Éviter les biopsies inutiles',
  'Diagnostics fondés sur la pathogenèse',
  'Découverte de cibles thérapeutiques',
  'Thérapies mécanistiquement informées',
];
const wp5 = [
  'Stratification du risque',
  'Automatisation du diagnostic de rejet',
  'Adaptation des thérapies (minimisation, intensification)',
  'Réponse au traitement',
];
const organes = [
  'Élargir le vivier d’organes de donneurs',
  'Améliorer le reconditionnement des organes transplantables',
  'Systèmes avancés d’évaluation de la viabilité et de la fonction',
];
const medecins = [
  'Prédiction par biomarqueurs non invasifs',
  'Microscope numérique & moléculaire',
  'Diagnostics automatisés',
  'Pronostic patient (perte du greffon, décès, infection, cancer, événements CV)',
];
const copilote = [
  'Télésurveillance',
  'Chatbot fondé sur un LLM',
  'Soin centré sur le patient',
  'Objets connectés (IoT)',
];
const essais = [
  'Essais cliniques virtualisés',
  'Critères de substitution numériques',
  'Découverte & repositionnement de médicaments par IA',
  'Jumeaux numériques',
];
const wp7 = [
  'Intégration des dimensions éthiques & réglementaires',
  'Barrières financières & santé fondée sur la valeur',
  'Formation des futurs spécialistes de la greffe',
  'Campagnes de sensibilisation & ateliers pratiques',
  'Communication renforcée avec les associations patients/donneurs',
  'Évaluation de l’empreinte écologique des greffes',
];
---

<div class="schema">
  <!-- WP1 -->
  <section class="box">
    <header><span class="code">WP1</span> Data lake multi-organes & cohortes phénotypées</header>
    <ul class="row">
      {wp1.map((i) => <li>{i}</li>)}
    </ul>
  </section>

  <!-- WP2&3 / WP4 / WP5 -->
  <div class="cols3">
    <section class="box">
      <header><span class="code">WP2 &amp; 3</span> Préservation, ingénierie tissulaire & greffes augmentées</header>
      <ul class="list">{wp23.map((i) => <li>{i}</li>)}</ul>
    </section>
    <section class="box">
      <header><span class="code">WP4</span> Biomarqueurs non invasifs & tissulaires</header>
      <ul class="list">{wp4.map((i) => <li>{i}</li>)}</ul>
    </section>
    <section class="box">
      <header><span class="code">WP5</span> Diagnostic & pronostic par IA</header>
      <ul class="list">{wp5.map((i) => <li>{i}</li>)}</ul>
    </section>
  </div>

  <!-- WP6 -->
  <section class="box">
    <header><span class="code">WP6</span> La première clinique IA de la transplantation</header>
    <div class="cols3 inner">
      <div class="subcard">
        <h4>Organes augmentés</h4>
        <ul class="list">{organes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="subcard">
        <h4>Médecins augmentés</h4>
        <ul class="list">{medecins.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="subcard">
        <h4>Copilote IA du patient</h4>
        <ul class="list">{copilote.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
    <div class="subband">
      <h4>Essais cliniques augmentés</h4>
      <ul class="row light">{essais.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <!-- WP7 -->
  <section class="box">
    <header><span class="code">WP7</span> Éthique, diffusion & formation</header>
    <ul class="row three">{wp7.map((i) => <li>{i}</li>)}</ul>
  </section>
</div>

<style>
  .schema { display: grid; gap: var(--space-3); }

  .box {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .box > header {
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .box > header .code {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .cols3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .cols3.inner { padding: var(--space-3); }

  /* Listes en puces vertes */
  .list { list-style: none; display: grid; gap: var(--space-2); padding: var(--space-3); margin: 0; }
  .cols3 .box .list { padding: var(--space-3); }
  .list li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Rangées horizontales (WP1, WP7, essais) */
  .row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-2);
    padding: var(--space-3);
    margin: 0;
  }
  .row.three { grid-template-columns: repeat(3, 1fr); }
  .row li {
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-2);
    border-radius: var(--radius);
    line-height: 1.35;
  }

  /* Sous-cartes du WP6 */
  .subcard {
    background: var(--color-accent-soft);
    border-radius: var(--radius);
    padding-bottom: var(--space-1);
  }
  .subcard h4 {
    background: var(--color-accent-dark);
    color: #fff;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .subcard .list li { color: var(--color-ink); }

  .subband { padding: 0 var(--space-3) var(--space-3); }
  .subband h4 {
    color: var(--color-accent-dark);
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
  }
  .row.light li { background: #fff; border: 1px solid var(--color-line); }

  @media (max-width: 820px) {
    .cols3 { grid-template-columns: 1fr; }
    .row.three { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .row.three { grid-template-columns: 1fr; }
  }
</style>
