const { wp1, wp23, wp4, wp5, organes, medecins, copilote, essais, wp7, h } = d;
---

<div class="schema">
  <!-- WP1 -->
  <section class="box">
    <header><span class="code">WP1</span> {h.wp1}</header>
    <ul class="row">
      {wp1.map((i) => <li>{i}</li>)}
    </ul>
  </section>

  <!-- WP2&3 / WP4 / WP5 -->
  <div class="cols3">
    <section class="box">
      <header><span class="code">WP2 &amp; 3</span> {h.wp23}</header>
      <ul class="list">{wp23.map((i) => <li>{i}</li>)}</ul>
    </section>
    <section class="box">
      <header><span class="code">WP4</span> {h.wp4}</header>
      <ul class="list">{wp4.map((i) => <li>{i}</li>)}</ul>
    </section>
    <section class="box">
      <header><span class="code">WP5</span> {h.wp5}</header>
      <ul class="list">{wp5.map((i) => <li>{i}</li>)}</ul>
    </section>
  </div>

  <!-- WP6 -->
  <section class="box">
    <header><span class="code">WP6</span> {h.wp6}</header>
    <div class="cols3 inner">
      <div class="subcard">
        <h4>{h.organes}</h4>
        <ul class="list">{organes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="subcard">
        <h4>{h.medecins}</h4>
        <ul class="list">{medecins.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="subcard">
        <h4>{h.copilote}</h4>
        <ul class="list">{copilote.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
    <div class="subband">
      <h4>{h.essais}</h4>
      <ul class="row light">{essais.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <!-- WP7 -->
  <section class="box">
    <header><span class="code">WP7</span> {h.wp7}</header>
    <ul class="row three">{wp7.map((i) => <li>{i}</li>)}</ul>
  </section>
</div>

<style>
  .schema { display: grid; gap: var(--space-3); }

  .box {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .box > header {
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .box > header .code {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .cols3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .cols3.inner { padding: var(--space-3); }

  /* Listes en puces vertes */
  .list { list-style: none; display: grid; gap: var(--space-2); padding: var(--space-3); margin: 0; }
  .cols3 .box .list { padding: var(--space-3); }
  .list li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Rangées horizontales (WP1, WP7, essais) */
  .row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-2);
    padding: var(--space-3);
    margin: 0;
  }
  .row.three { grid-template-columns: repeat(3, 1fr); }
  .row li {
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-2);
    border-radius: var(--radius);
    line-height: 1.35;
  }

  /* Sous-cartes du WP6 */
  .subcard {
    background: var(--color-accent-soft);
    border-radius: var(--radius);
    padding-bottom: var(--space-1);
  }
  .subcard h4 {
    background: var(--color-accent-dark);
    color: #fff;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .subcard .list li { color: var(--color-ink); }

  .subband { padding: 0 var(--space-3) var(--space-3); }
  .subband h4 {
    color: var(--color-accent-dark);
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
  }
  .row.light li { background: #fff; border: 1px solid var(--color-line); }

  @media (max-width: 820px) {
    .cols3 { grid-template-columns: 1fr; }
    .row.three { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .row.three { grid-template-columns: 1fr; }
  }
</style>
