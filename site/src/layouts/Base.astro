---
// Shared shell for every page: head, header, footer.
// Nav lives here and only here; adding a page means adding one link below.
import '../../../source/brand/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Onglet actif : on normalise le chemin (avec/sans slash final).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === path;

// Personalized during setup.
const siteName = 'PEPR TREASURE';
const nav: { href: string; label: string }[] = [
  { href: '/', label: 'Accueil' },
  { href: '/wp2', label: 'WP2 — Perfusion' },
  { href: '/wp7', label: 'WP7 — SHS' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={siteName}>
          <img src="/logo-treasure.png" alt={siteName} width="120" height="96" />
        </a>
        {nav.length > 0 && (
          <nav class="tabs">
            {nav.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? 'tab is-active' : 'tab'}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="funders">
        <span class="funders-label">Avec le soutien de</span>
        <img class="funders-logo" src="/france-2030.png" alt="France 2030" width="322" height="316" />
        <img class="funders-logo" src="/logo-anr.png" alt="Agence nationale de la recherche (ANR)" width="458" height="110" />
        <img class="funders-logo" src="/logo-aphp.png" alt="Assistance Publique – Hôpitaux de Paris (AP-HP)" width="493" height="102" />
      </div>
      <p class="copyright">© {new Date().getFullYear()} {siteName}</p>
    </footer>
  </body>
</html>
