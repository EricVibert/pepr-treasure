---
// Shared shell for every page: head, header, footer.
// Bilingue : le français est la langue par défaut (racine), l'anglais vit sous /en/.
// La langue est déduite de l'URL ; chaque page FR a une page EN au même slug sous /en/.
import '../../../source/brand/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Détection de langue à partir de l'URL.
const rawPath = Astro.url.pathname;
const isEn = rawPath === '/en' || rawPath.startsWith('/en/');
const lang = isEn ? 'en' : 'fr';

// URLs équivalentes dans l'autre langue (mêmes slugs, préfixe /en).
const stripEn = (p: string) => {
  const s = p.replace(/^\/en(?=\/|$)/, '');
  return s === '' ? '/' : s;
};
const frUrl = isEn ? stripEn(rawPath) : rawPath;
const enUrl = isEn ? rawPath : '/en' + (rawPath === '/' ? '/' : rawPath);

// Onglet actif : on normalise le chemin (avec/sans slash final).
const path = rawPath.replace(/\/+$/, '') || '/';
const norm = (href: string) => href.replace(/\/+$/, '') || '/';
const isActive = (item: { href: string; activeOn?: string[] }) => {
  if (norm(item.href) === path) return true;
  return (item.activeOn ?? []).some((p) => path === p || path.startsWith(p));
};

const siteName = 'PEPR TREASURE';

const navFR: { href: string; label: string; activeOn?: string[] }[] = [
  { href: '/', label: 'Accueil' },
  { href: '/equipe', label: 'Équipe / COPIL' },
  { href: '/le-projet', label: 'Le projet' },
  { href: '/verrous', label: 'Les verrous' },
  { href: '/work-packages', label: 'Work packages', activeOn: ['/wp'] },
  { href: '/actualites', label: 'Actualités' },
];
const navEN: { href: string; label: string; activeOn?: string[] }[] = [
  { href: '/en/', label: 'Home' },
  { href: '/en/equipe', label: 'Team / Steering' },
  { href: '/en/le-projet', label: 'The project' },
  { href: '/en/verrous', label: 'Challenges' },
  { href: '/en/work-packages', label: 'Work packages', activeOn: ['/en/wp'] },
  { href: '/en/actualites', label: 'News' },
];
const nav = isEn ? navEN : navFR;
const homeHref = isEn ? '/en/' : '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="topbar">
      <div class="topbar-inner">
        <img class="funders-logo" src="/france-2030.png" alt="France 2030" width="322" height="316" />
        <img class="funders-logo" src="/logo-anr.png" alt="Agence nationale de la recherche (ANR)" width="458" height="110" />
        <img class="funders-logo funders-logo--inserm" src="/logo-inserm.png" alt="Inserm" width="426" height="240" />
        <img class="funders-logo" src="/logo-agence-sante.png" alt="Agence de programmes de recherche en santé" width="292" height="122" />
        <img class="funders-logo" src="/logo-aphp.png" alt="Assistance Publique – Hôpitaux de Paris (AP-HP)" width="493" height="102" />
      </div>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={homeHref} aria-label={siteName}>
          <img src="/logo-treasure.png" alt={siteName} width="120" height="96" />
        </a>
        <div class="header-right">
          {nav.length > 0 && (
            <nav class="tabs">
              {nav.map((item) => (
                <a
                  href={item.href}
                  class={isActive(item) ? 'tab is-active' : 'tab'}
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          )}
          <div class="lang" aria-label="Choix de la langue">
            <a href={frUrl} class={lang === 'fr' ? 'on' : ''} aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
            <span aria-hidden="true">/</span>
            <a href={enUrl} class={lang === 'en' ? 'on' : ''} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          </div>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="copyright">© {new Date().getFullYear()} {siteName}</p>
    </footer>
  </body>
</html>
